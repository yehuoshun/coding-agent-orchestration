{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "handoff",
  "type": "object",
  "required": ["task_id", "goal", "repo", "base_ref", "subtasks"],
  "properties": {
    "task_id": { "type": "string" },
    "goal": { "type": "string", "description": "一句话说明要达成什么（可验收）" },
    "repo": { "type": "string" },
    "base_ref": { "type": "string", "description": "从哪个分支/commit 起跑" },
    "worktree": { "type": "string", "description": "独立工作目录（必须）" },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "subtasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "files", "verify"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } },
          "verify": { "type": "string", "description": "可执行的验收命令" },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "token_budget": { "type": "integer", "description": "该子任务 token 上限" }
        }
      }
    }
  }
}
